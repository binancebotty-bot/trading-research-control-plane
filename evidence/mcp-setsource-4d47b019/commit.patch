@@ -0,0 +1,31 @@
+import fs from 'node:fs';
+import vm from 'node:vm';
+import assert from 'node:assert/strict';
+import test from 'node:test';
+const file = new URL('../src/core/pine.js', import.meta.url);
+const code = fs.readFileSync(file, 'utf8').replace(/import \{ evaluate, evaluateAsync, getClient \} from '[^']+';/, 'const evaluate = globalThis.__evaluate; const evaluateAsync = evaluate; const getClient = async () => ({});');
+globalThis.__evaluate = async expr => vm.runInNewContext(expr, globalThis.__context);
+const {setSource} = await import('data:text/javascript;base64,' + Buffer.from(code).toString('base64'));
+function fixture({missing=false,noop=false}={}) {
+  let value = 'ORIGINAL'; let focused = 0;
+  const editor = { getValue:()=>value, setValue:s=>{if(!noop)value=s;} };
+  const container = {__reactFiber$test:{memoizedProps:{value:{monacoEnv:{editor:{getEditors:()=>[editor]}}}}}};
+  const ta = {value:'', focus:()=>focused++, setSelectionRange:()=>{}, dispatchEvent:()=>{}};
+  const document = {querySelector:s=>s.includes('textarea')?ta:(missing?null:container),execCommand:()=>{}};
+  const context = {document,window:{},Event:class{},getComputedStyle:()=>({})};
+  globalThis.__context=context;
+  return {editor,context,value:()=>value,focused:()=>focused};
+}
+test('success changes genuine Monaco source, not hidden textarea', async () => {
+  const f=fixture(); const r=await setSource({source:'NEW\nSOURCE'});
+  assert.equal(r.success,true); assert.equal(f.value(),'NEW\nSOURCE');
+  assert.equal(f.focused(),0); assert.equal(r.lines_set,2);
+});
+test('missing model fails closed without touching textarea', async () => {
+  const f=fixture({missing:true}); const r=await setSource({source:'NEW'});
+  assert.equal(r.success,false); assert.equal(f.value(),'ORIGINAL'); assert.equal(f.focused(),0);
+});
+test('no-op setter cannot report success', async () => {
+  const f=fixture({noop:true}); const r=await setSource({source:'NEW'});
+  assert.equal(r.success,false); assert.equal(f.value(),'ORIGINAL');
+});
