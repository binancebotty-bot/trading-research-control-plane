+code=code.replace(/import \{ evaluate, evaluateAsync, getClient, getTargetInfo \} from '[^']+';/, 'const evaluate=globalThis.__labEvaluate; const evaluateAsync=evaluate; const getClient=async()=>globalThis.__labClient; const getTargetInfo=()=>({});');
+code=code.replace(/import \{ getStrategyResults \} from '[^']+';/,'const getStrategyResults=async()=>({});');
+code='const setTimeout=(fn)=>{fn();return 0};\n'+code;
+globalThis.__labEvaluate=async expr=>{
