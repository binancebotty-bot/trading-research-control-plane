+}
+test('ADD no-op remains unconfirmed',async()=>{const f=fixture({label:'Add to chart'});const r=await addToChart();assert.equal(r.success,false);assert.equal(f.clicks(),1);});
+test('ADD extra unexpected identities remains unconfirmed',async()=>{const f=fixture({label:'Add to chart',confirm:true,extraOnClick:true});const r=await addToChart();assert.equal(r.success,false);assert.equal(f.clicks(),1);});
+test('MCP registration exposes optional expected_study_id without coercion',()=>{const all={};registerLabTools({tool(name,description,schema,handler){all[name]={schema,handler};}});const field=all.pine_add_to_chart.schema.expected_study_id;assert.ok(field);assert.equal(field.safeParse('existing').success,true);assert.equal(field.safeParse(123).success,false);});
