+ const document={body:{innerText:''},querySelector:s=>s.includes('pine-editor-monaco')?container:s.includes('textarea')?{}:null,querySelectorAll:s=>s.includes('button')&&!noControl?Array(controls).fill(button):[]};
+ const source={id:()=> 'existing',metaInfo:()=>{metadataReads++;throw new Error('metaInfo version is not proof');}};
+ const model={dataSources:()=>[source]};
+ const window={TradingViewApi:{activeChart:()=>({getAllStudies:()=>studies}),_activeChartWidgetWV:{value:()=>({_chartWidget:{model:()=>model}})}}};
+ globalThis.__labContext={document,window,getComputedStyle:()=>({display:'block',visibility:'visible'})};
+ globalThis.__labClient={Input:{dispatchKeyEvent:async()=>{keys++;}}};
+ globalThis.__labBeforeClick=disableAtClick?()=>{button.disabled=true;}:null;
+ return {keys:()=>keys,clicks:()=>clicks,metadataReads:()=>metadataReads};
+}
+const update={expected_study_id:'existing'};
+test('disabled QA update never invokes keys or clicks',async()=>{const f=fixture({disabled:true});const r=await addToChart(update);assert.equal(r.success,false);assert.equal(f.keys(),0);assert.equal(f.clicks(),0);});
+test('renamed editor title dispatches exactly once to stable ID without metadata',async()=>{const f=fixture({confirm:true,editorTitle:'SENTINEL'});const r=await addToChart(update);assert.equal(r.success,true,JSON.stringify(r));assert.equal(f.clicks(),1);assert.equal(f.keys(),0);assert.equal(f.metadataReads(),0);assert.equal(r.update_dispatched,true);assert.equal(r.applied_source_certified,false);assert.equal(r.study_updated,false);assert.equal(r.after.studies[0].name,'SENTINEL');});
+test('unchanged chart can attest dispatch only, never applied source',async()=>{const f=fixture({qa:false});const r=await addToChart(update);assert.equal(r.success,true,JSON.stringify(r));assert.equal(r.status,'OK_UPDATE_DISPATCHED');assert.equal(r.applied_source_certified,false);assert.equal(r.study_updated,false);assert.equal(f.clicks(),1);assert.equal(f.metadataReads(),0);});
+test('missing action control refuses without keyboard fallback',async()=>{const f=fixture({noControl:true});const r=await addToChart(update);assert.equal(r.success,false);assert.equal(f.keys(),0);assert.equal(f.clicks(),0);});
+test('explicit update refusal preserves chart and does not click',async()=>{const f=fixture({confirm:true});const r=await addToChart({...update,allow_update_existing:false});assert.equal(r.success,false);assert.equal(f.clicks(),0);});
+test('confirmed ADD preserves exact newly created identity without expected ID',async()=>{const f=fixture({label:'Add to chart',confirm:true});const r=await addToChart();assert.equal(r.success,true,JSON.stringify(r));assert.equal(r.status,'OK_ADDED_TO_CHART');assert.equal(r.study_added,true);assert.equal(r.created_studies[0].id,'created');assert.equal(f.keys(),0);});
+for(const [name,args] of [['missing',{}],['wrong',{expected_study_id:'other'}],['empty',{expected_study_id:''}],['non-string',{expected_study_id:123}],['whitespace',{expected_study_id:' existing '}]] ){
