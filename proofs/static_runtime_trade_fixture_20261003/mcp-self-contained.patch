+import test from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import vm from 'node:vm';
+
+const source=fs.readFileSync('src/core/data.js','utf8');
+const body=source.slice(source.indexOf('export async function getTrades'),source.indexOf('export async function getEquity')).replace('export async','async');
+function fixture(count=6,ambiguous=false){
+ const orders=Array.from({length:count},(_,i)=>({id:String(i),p:10+i,q:1,e:i%2===0}));
+ const trades=Array.from({length:count/2},()=>({e:{tm:1000,p:10},x:{tm:2000,p:11},q:1,tp:{v:1},cm:0}));
+ const strat={ordersData:()=>({value:()=>orders}),reportData:()=>({value:()=>({trades})}),name:()=> 'Controlled'};
+ const world={window:{TradingViewApi:{_activeChartWidgetWV:{value:()=>({_chartWidget:{model:()=>({model:()=>({dataSources:()=>ambiguous?[strat,strat]:[strat]})})}})}}}};
+ const context={CHART_API:'window.TradingViewApi._activeChartWidgetWV.value()',evaluate:async script=>vm.runInNewContext(script,world)};
+ return vm.runInNewContext(body+';getTrades',context);
+}
+test('raw orders remain distinct from native report closed trades, complete streams',async()=>{
+ const r=await fixture()( {max_trades:50});
+ assert.equal(r.raw_order_record_count,6);assert.equal(r.record_semantics,'raw_order_records');
+ assert.equal(r.order_stream_complete,true);assert.equal(r.closed_trades.length,3);
+ assert.equal(r.closed_trade_stream_complete,true);assert.equal(r.closed_trade_semantics,'native_reportData_trades');
+});
+test('caller configurable cap reports both stream truncations',async()=>{
+ const r=await fixture(100)({max_trades:30});assert.equal(r.raw_order_record_count,30);
+ assert.equal(r.total_available_order_records,100);assert.equal(r.order_stream_complete,false);
+ assert.equal(r.closed_trades.length,30);assert.equal(r.closed_trade_stream_complete,false);
+});
+test('ambiguous strategy refuses and invalid limits throw',async()=>{
+ const r=await fixture(6,true)();assert.equal(r.success,false);assert.match(r.error,/ambiguous/);
+ await assert.rejects(()=>fixture()({max_trades:0}),/1..1000/);
+});
