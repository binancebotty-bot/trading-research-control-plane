+import fs from 'node:fs';
+import vm from 'node:vm';
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { registerLabTools } from '../src/tools/lab.js';
+let code=fs.readFileSync(new URL('../src/core/lab.js',import.meta.url),'utf8');
+code=code.replace(/import \{ evaluate, evaluateAsync, getClient, getTargetInfo \} from '[^']+';/, 'const evaluate=globalThis.__labEvaluate; const evaluateAsync=evaluate; const getClient=async()=>globalThis.__labClient; const getTargetInfo=()=>({});');
+code=code.replace(/import \{ getStrategyResults \} from '[^']+';/,'const getStrategyResults=async()=>({});');
+code='const setTimeout=(fn)=>{fn();return 0};\n'+code;
+globalThis.__labEvaluate=async expr=>{
+  if(expr.includes('c.element.click()')) globalThis.__labBeforeClick?.();
+  return vm.runInNewContext(expr,globalThis.__labContext);
+};
+const {addToChart}=await import('data:text/javascript;base64,'+Buffer.from(code).toString('base64'));
+function fixture({disabled=false,label='Update on chart',qa=true,confirm=false,noControl=false,editorTitle='Aggressive Flow Momentum',initialStudies,extraOnClick=false,removeOnClick=false,duplicateAfter=false,controls=1,disableAtClick=false}={}){
+ let keys=0,clicks=0,metadataReads=0;
+ let studies=(initialStudies??[{id:'existing',name:'Aggressive Flow Momentum'}]).map(s=>({...s}));
+ const button={disabled,offsetParent:{},textContent:qa?'':label,innerText:qa?'':label,getAttribute:k=>k==='data-qa-id'&&qa?'add-script-to-chart':null,__reactProps$test:{title:label},click(){
+  clicks++;
+  if(confirm){if(label==='Add to chart')studies.push({id:'created',name:editorTitle});else studies=studies.map(s=>s.id==='existing'?{...s,name:editorTitle}:s);}
+  if(extraOnClick)studies.push({id:'unexpected',name:editorTitle});
+  if(removeOnClick)studies=studies.filter(s=>s.id!=='existing');
+  if(duplicateAfter)studies.push({id:'existing',name:editorTitle});
+ }};
+ const editor={getValue:()=> 'strategy('+JSON.stringify(editorTitle)+')',setValue:()=>{throw new Error('source writes forbidden');}};
+ const container={__reactFiber$test:{memoizedProps:{value:{monacoEnv:{editor:{getEditors:()=>[editor]}}}},return:null}};
+ const document={body:{innerText:''},querySelector:s=>s.includes('pine-editor-monaco')?container:s.includes('textarea')?{}:null,querySelectorAll:s=>s.includes('button')&&!noControl?Array(controls).fill(button):[]};
+ const source={id:()=> 'existing',metaInfo:()=>{metadataReads++;throw new Error('metaInfo version is not proof');}};
+ const model={dataSources:()=>[source]};
+ const window={TradingViewApi:{activeChart:()=>({getAllStudies:()=>studies}),_activeChartWidgetWV:{value:()=>({_chartWidget:{model:()=>model}})}}};
+ globalThis.__labContext={document,window,getComputedStyle:()=>({display:'block',visibility:'visible'})};
+ globalThis.__labClient={Input:{dispatchKeyEvent:async()=>{keys++;}}};
+ globalThis.__labBeforeClick=disableAtClick?()=>{button.disabled=true;}:null;
+ return {keys:()=>keys,clicks:()=>clicks,metadataReads:()=>metadataReads};
+}
+const update={expected_study_id:'existing'};
+test('disabled QA update never invokes keys or clicks',async()=>{const f=fixture({disabled:true});const r=await addToChart(update);assert.equal(r.success,false);assert.equal(f.keys(),0);assert.equal(f.clicks(),0);});
+test('renamed editor title dispatches exactly once to stable ID without metadata',async()=>{const f=fixture({confirm:true,editorTitle:'SENTINEL'});const r=await addToChart(update);assert.equal(r.success,true,JSON.stringify(r));assert.equal(f.clicks(),1);assert.equal(f.keys(),0);assert.equal(f.metadataReads(),0);assert.equal(r.update_dispatched,true);assert.equal(r.applied_source_certified,false);assert.equal(r.study_updated,false);assert.equal(r.after.studies[0].name,'SENTINEL');});
+test('unchanged chart can attest dispatch only, never applied source',async()=>{const f=fixture({qa:false});const r=await addToChart(update);assert.equal(r.success,true,JSON.stringify(r));assert.equal(r.status,'OK_UPDATE_DISPATCHED');assert.equal(r.applied_source_certified,false);assert.equal(r.study_updated,false);assert.equal(f.clicks(),1);assert.equal(f.metadataReads(),0);});
+test('missing action control refuses without keyboard fallback',async()=>{const f=fixture({noControl:true});const r=await addToChart(update);assert.equal(r.success,false);assert.equal(f.keys(),0);assert.equal(f.clicks(),0);});
+test('explicit update refusal preserves chart and does not click',async()=>{const f=fixture({confirm:true});const r=await addToChart({...update,allow_update_existing:false});assert.equal(r.success,false);assert.equal(f.clicks(),0);});
+test('confirmed ADD preserves exact newly created identity without expected ID',async()=>{const f=fixture({label:'Add to chart',confirm:true});const r=await addToChart();assert.equal(r.success,true,JSON.stringify(r));assert.equal(r.status,'OK_ADDED_TO_CHART');assert.equal(r.study_added,true);assert.equal(r.created_studies[0].id,'created');assert.equal(f.keys(),0);});
+for(const [name,args] of [['missing',{}],['wrong',{expected_study_id:'other'}],['empty',{expected_study_id:''}],['non-string',{expected_study_id:123}],['whitespace',{expected_study_id:' existing '}]] ){
+ test(name+' expected study ID refuses before click',async()=>{const f=fixture();const r=await addToChart(args);assert.equal(r.success,false);assert.equal(f.clicks(),0);assert.equal(f.keys(),0);});
+}
+test('duplicate pre-operation expected ID refuses',async()=>{const f=fixture({initialStudies:[{id:'existing',name:'One'},{id:'existing',name:'Two'}]});const r=await addToChart(update);assert.equal(r.success,false);assert.equal(f.clicks(),0);});
+test('missing expected ID in chart refuses',async()=>{const f=fixture({initialStudies:[]});const r=await addToChart(update);assert.equal(r.success,false);assert.equal(f.clicks(),0);});
+test('ambiguous Update control refuses',async()=>{const f=fixture({controls:2});const r=await addToChart(update);assert.equal(r.success,false);assert.equal(f.clicks(),0);});
+test('control becoming disabled before dispatch refuses',async()=>{const f=fixture({disableAtClick:true});const r=await addToChart(update);assert.equal(r.success,false);assert.equal(f.clicks(),0);});
+for(const flag of ['extraOnClick','removeOnClick','duplicateAfter']){
+ test(flag+' fails post-dispatch with no certification and no retry',async()=>{const f=fixture({[flag]:true});const r=await addToChart(update);assert.equal(r.success,false,JSON.stringify(r));assert.equal(r.applied_source_certified,false);assert.equal(f.clicks(),1);assert.equal(f.keys(),0);});
+}
+test('ADD no-op remains unconfirmed',async()=>{const f=fixture({label:'Add to chart'});const r=await addToChart();assert.equal(r.success,false);assert.equal(f.clicks(),1);});
+test('ADD extra unexpected identities remains unconfirmed',async()=>{const f=fixture({label:'Add to chart',confirm:true,extraOnClick:true});const r=await addToChart();assert.equal(r.success,false);assert.equal(f.clicks(),1);});
+test('MCP registration exposes optional expected_study_id without coercion',()=>{const all={};registerLabTools({tool(name,description,schema,handler){all[name]={schema,handler};}});const field=all.pine_add_to_chart.schema.expected_study_id;assert.ok(field);assert.equal(field.safeParse('existing').success,true);assert.equal(field.safeParse(123).success,false);});
