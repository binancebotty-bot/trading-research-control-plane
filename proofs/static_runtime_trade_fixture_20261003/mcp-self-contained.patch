+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { spawn } from 'node:child_process';
+import readline from 'node:readline';
+
+test('clean stdio startup exposes required runtime tools without CDP calls', {timeout:20000}, async () => {
+ const child=spawn(process.execPath,['src/server.js'],{cwd:process.cwd(),windowsHide:true,stdio:['pipe','pipe','pipe']});
+ let err=''; child.stderr.on('data',b=>err+=b);
+ const waiting=new Map(); const rl=readline.createInterface({input:child.stdout});
+ rl.on('line', line=>{try {const o=JSON.parse(line); if(waiting.has(o.id)){waiting.get(o.id)(o); waiting.delete(o.id);}}catch{}});
+ let id=0;
+ const request=(method,params)=>new Promise((resolve,reject)=>{
+   const n=++id; const timeout=setTimeout(()=>reject(new Error('RPC timeout '+method+' '+err)),8000);
+   waiting.set(n,o=>{clearTimeout(timeout); if(o.error)reject(new Error(JSON.stringify(o.error)));else resolve(o.result);});
+   child.stdin.write(JSON.stringify({jsonrpc:'2.0',id:n,method,params})+'\n');
+ });
+ try {
+   await request('initialize',{protocolVersion:'2024-11-05',capabilities:{},clientInfo:{name:'isolated-startup-regression',version:'1'}});
+   child.stdin.write(JSON.stringify({jsonrpc:'2.0',method:'notifications/initialized'})+'\n');
+   const result=await request('tools/list',{});
+   const names=result.tools.map(t=>t.name);
+   for(const n of ['pine_set_source','pine_add_to_chart','strategy_tester_read_summary','data_get_trades','data_get_equity']) assert.ok(names.includes(n),'missing '+n);
+   assert.equal(names.filter(n=>n==='pine_compile').length,1);
+   assert.ok(!names.includes('live_place_order'),'unrelated live tools excluded');
+ } finally {rl.close();child.stdin.end();child.kill();}
+});
