//@version=6
strategy("Hermes TV Timestamp 3L Fixture", overlay=true, initial_capital=100000, currency=currency.NONE, default_qty_type=strategy.fixed, default_qty_value=1, pyramiding=0, commission_type=strategy.commission.percent, commission_value=0, slippage=0, process_orders_on_close=true, calc_on_every_tick=false, calc_on_order_fills=false)
if syminfo.tickerid != "BINANCE:ETHUSDT" or timeframe.period != "15"
